# Runtime
APP_ENV=local
DATA_DIR=./data
CORPUS_DIR=./data/corpus
CHECKPOINT_DB=./data/checkpoints.db
AUDIT_DB=./data/audit.db
VECTOR_DIR=./data/vector_store

# LLM: stub (default, deterministic) | openai_compatible
LLM_PROVIDER=stub
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
PROMPT_VERSION=v1

# Embeddings: stub (default) | openai_compatible
EMBEDDING_PROVIDER=stub
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# Retrieval: hybrid (default) | vector | bm25
# vector and bm25 are kept as A/B baselines for the evaluation harness.
RETRIEVAL_MODE=hybrid
CANDIDATE_K=20
RRF_K=60
BM25_K1=1.5
BM25_B=0.75

# Reranking: stub (deterministic lexical, offline) | llm | cross_encoder | none
# cross_encoder needs the optional extra: pip install -e ".[rerank]"
RERANKER_PROVIDER=stub
RERANK_ENABLED=true
RERANK_CANDIDATES=20
RERANK_TEXT_CHARS=900
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base

# Near-duplicate suppression and diversity selection
DEDUP_THRESHOLD=0.85
DEDUP_SHINGLE_SIZE=5
MMR_LAMBDA=0.7
PER_SOURCE_CAP=2

# Context assembly and grounded generation
CONTEXT_TOKEN_BUDGET=800
RELEVANCE_FLOOR=0.12
COVERAGE_FLOOR=0.5

# Governance labels stamped on every ingested document; retrieval filters read these.
DEFAULT_CLASSIFICATION=internal
DEFAULT_OWNER=platform-engineering

# Security
MAX_PAYLOAD_CHARS=12000
REQUIRE_APPROVAL_FOR_WRITES=true

# Tool transport: mcp (stdio client/server) | local
TOOL_TRANSPORT=mcp
MCP_SERVER_MODULE=agent_runtime.tools.mcp_requirement_server
